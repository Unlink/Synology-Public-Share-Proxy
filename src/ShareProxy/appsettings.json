{
    "Proxy": {
        "DsmOrigin": "https://nas.example:5001",
        "PublicOrigin": "https://share.example.com",
        "MaxUploadBytes": 1073741824,
        "MaxDownloadBytes": 10737418240,
        "MetadataTimeoutSeconds": 20,
        "TransferTimeoutSeconds": 1800,
        "IdleTimeoutSeconds": 60,
        "SessionMinutes": 30,
        "MaxSessions": 256,
        "MaxConcurrentTransfers": 4,
        "UploadsEnabled": true,
        "PasswordLoginEnabled": true
    },
  "Logging": { "LogLevel": { "Default": "Warning", "Microsoft.AspNetCore": "None", "System.Net.Http.HttpClient": "None" } }
}
