# Use a NAS hostname whose TLS certificate is valid and trusted by the container.
# This hostname must resolve to DSM from INSIDE the container, not to this public proxy.
# Include http:// or https:// and the DSM port, without a /sharing path, credentials or query.
# HTTP and HTTPS accept any configured hostname or IP; HTTPS certificates remain verified.
DSM_ORIGIN=https://nas.internal.example:5001
PUBLIC_ORIGIN=https://share.example.com
PROXY_PORT=8088
UPLOADS_ENABLED=true
PASSWORD_LOGIN_ENABLED=true
MAX_UPLOAD_BYTES=1073741824
MAX_DOWNLOAD_BYTES=10737418240
MAX_CONCURRENT_TRANSFERS=4
TRANSFER_TIMEOUT_SECONDS=1800
IDLE_TIMEOUT_SECONDS=60
# Safe operation/stage logs in addition to errors. Never logs URLs, tokens or payloads.
DIAGNOSTICS_VERBOSE=false
